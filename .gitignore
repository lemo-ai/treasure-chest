# Accidental tsc emit beside sources (real build output is out/).
# Vite prefers sibling .js over .ts — stale emits can ship old catalog URLs.
# Keep src/env.d.ts, src/css-modules.d.ts, and src/types/** tracked.
electron.vite.config.js
electron.vite.config.d.ts
electron/**/*.js
electron/**/*.d.ts
packages/**/*.js
packages/**/*.d.ts
src/app/**/*.js
src/app/**/*.d.ts
src/features/**/*.js
src/features/**/*.d.ts
src/shared/**/*.js
src/shared/**/*.d.ts
src/main.js
src/main.d.ts
