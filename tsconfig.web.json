{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@shared": ["packages/shared/src/index.ts"],
      "@config/*": ["config/*"]
    }
  },
  "include": [
    "src/**/*",
    "packages/shared/src/**/*",
    "config/changelog.json"
  ]
}
